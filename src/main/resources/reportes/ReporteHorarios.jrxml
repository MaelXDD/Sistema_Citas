<jasperReport name="Reporte" language="java" columnCount="1" pageWidth="760" pageHeight="595" orientation="Landscape" columnWidth="720" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="073666a3-80c7-4b8e-9dcc-f2856ffd6ff5">
