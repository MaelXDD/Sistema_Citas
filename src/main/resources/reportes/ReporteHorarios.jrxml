	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SistemaCitas"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<query language="SQL"><![CDATA[SELECT
    d.apellidos || ', ' || d.nombres AS doctor,
    e.nombre AS especialidad,
    h.dia_semana,
    TO_CHAR(h.hora_inicio, 'HH24:MI') || ' - ' || TO_CHAR(h.hora_fin, 'HH24:MI') AS horario,
    CASE
        WHEN h.hora_fin <= TIME '12:00:00' THEN 'Mañana'
        WHEN h.hora_inicio >= TIME '12:00:00' THEN 'Tarde'
        ELSE 'Intermedio'
    END AS turno,
    ROUND((EXTRACT(EPOCH FROM (h.hora_fin - h.hora_inicio)) / 3600)::numeric, 1) AS horas,
    e.monto AS tarifa
FROM horarios h
JOIN doctores d ON d.id_doctor = h.id_doctor
JOIN especialidades e ON e.id_especialidad = d.id_especialidad
WHERE h.activo = true
ORDER BY d.apellidos, d.nombres,
    CASE UPPER(h.dia_semana)
        WHEN 'LUNES' THEN 1 WHEN 'MARTES' THEN 2 WHEN 'MIÉRCOLES' THEN 3
        WHEN 'JUEVES' THEN 4 WHEN 'VIERNES' THEN 5 WHEN 'SÁBADO' THEN 6
        WHEN 'DOMINGO' THEN 7
    END,
    h.hora_inicio]]></query>
	<field name="doctor" class="java.lang.String"/>
	<field name="especialidad" class="java.lang.String"/>
	<field name="dia_semana" class="java.lang.String"/>
	<field name="horario" class="java.lang.String"/>
	<field name="turno" class="java.lang.String"/>
	<field name="horas" class="java.math.BigDecimal"/>
	<field name="tarifa" class="java.math.BigDecimal"/>
	<variable name="TOT_TUR" calculation="Count" class="java.lang.Integer">
		<expression><![CDATA[$F{doctor}]]></expression>
	</variable>
	<variable name="TOT_HOR" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{horas}]]></expression>
	</variable>
