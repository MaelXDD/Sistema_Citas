		<property name="com.jaspersoft.studio.field.label" value="nombre"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="especialidades"/>
	</field>
	<field name="descripcion" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="descripcion"/>
		<property name="com.jaspersoft.studio.field.label" value="descripcion"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="especialidades"/>
	</field>
	<field name="activo" class="java.lang.Boolean">
		<property name="com.jaspersoft.studio.field.name" value="activo"/>
		<property name="com.jaspersoft.studio.field.label" value="activo"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="especialidades"/>
	</field>
	<field name="total_doctores" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="total_doctores"/>
		<property name="com.jaspersoft.studio.field.label" value="total_doctores"/>
	</field>
	<field name="total_citas" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="total_citas"/>
		<property name="com.jaspersoft.studio.field.label" value="total_citas"/>
	</field>
	<variable name="TOT_ESP" calculation="Count" class="java.lang.Integer">
		<expression><![CDATA[$F{nombre}]]></expression>
	</variable>
	<variable name="TOT_DOC" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{total_doctores}]]></expression>
	</variable>
	<variable name="TOT_CIT" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{total_citas}]]></expression>
	</variable>
