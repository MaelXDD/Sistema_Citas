<jasperReport name="ReportePacientes" language="java" columnCount="1" pageWidth="760" pageHeight="595" orientation="Landscape" columnWidth="720" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="819a6b74-4409-401f-8a4a-676bab0ffa4e">
