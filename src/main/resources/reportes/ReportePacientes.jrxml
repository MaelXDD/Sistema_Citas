	</field>
	<field name="total_pagos" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="total_pagos"/>
		<property name="com.jaspersoft.studio.field.label" value="total_pagos"/>
	</field>
	<field name="cantidad_citas" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="cantidad_citas"/>
		<property name="com.jaspersoft.studio.field.label" value="cantidad_citas"/>
	</field>
	<variable name="TOT_PAG" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{total_pagos}]]></expression>
	</variable>
	<variable name="TOT_CIT" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{cantidad_citas}]]></expression>
	</variable>
