# --- Gemini (solo en el servidor, nunca en el frontend) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Respaldo si el principal esta saturado (503) o no existe (404). Separados por coma.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# --- BD del bot: la MISMA Supabase del proyecto, esquema "bot" (separado de "public") ---
# Supabase > Connect > Connection string (Session pooler, puerto 5432, o Transaction pooler, 6543)
BOT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Auth: MISMO secreto que usa Spring para firmar el JWT (HS256, minimo 32 caracteres) ---
BOT_JWT_SECRET=
BOT_JWT_ISSUER=citas-api
BOT_JWT_ROLE_CLAIM=rol
BOT_JWT_NAME_CLAIM=nombre
BOT_JWT_DEFAULT_ROLE=PACIENTE

# --- Proyecto activo ---
BOT_PROJECT=citas
CITAS_API_URL=http://localhost:8087

# --- Limites ---
BOT_RATE_LIMIT_PER_MIN=12
BOT_HISTORY_MESSAGES=16
BOT_CORS_ORIGINS=http://localhost:8087
